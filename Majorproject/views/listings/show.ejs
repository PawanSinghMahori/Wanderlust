<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3> <%= listing.title %> </h3><br>
</div>
<div class="card col-6 offset-2">
    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image"><br>
    <div class="card-body">
        <p class="card-text">
            <%= listing.description %><br>
            &#8377; <%= listing.price != null ? listing.price.toLocaleString('en-IN') : 'Price not available' %><br>
            <%= listing.location %><br>
            <%= listing.country %><br>
        </p>
    </div>
</div>
<div class="d-flex col-8 offset-2 gap-5 mt-4 mb-4">
    <a href="/listings/<%= listing._id %>/edit"
       class="btn btn-danger">
        Edit
    </a>

    <form action="/listings/<%= listing._id %>?_method=DELETE"
          method="POST"
          class="m-0">
        <button type="submit" class="btn btn-danger">
            Delete
        </button>
    </form>
</div>
</div>
<div class="col-6 offset-2">
    <hr> <!-- horizontal line -->
    <h4> Leave a Review</h4>
    <form>
        <div class="mb-3  mt-3"><br>
            <label for="rating" class="form-label"> Rating</label>
            <input type="range" name="review[rating]" id="rating" min="1" max="5" class ="form-range">
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label"> Comments</label><br>
            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"></textarea></textarea>
        </div><br>
        <button class="btn btn-outline-dark"> Submit </button>

    </form>
</div>
</div>
